# libCarPlayCore (G70 KR V039, ef49c09b): ProcessFrames waits 10 s for a video frame, not 200 ms (movs r7,#0 / movt r7,#0xffff -> movs r7,#10 / movt r7,#0),
# so a short Wi-Fi stall no longer ends the CarPlay video stream (the picture froze while the sound went on).
# The same change as Open-HMG/hmgapi-wireless-cp-aa dbb3791 (its verify region has the same hashes, at 0x147a2 in
# the US library) and NEMESIS's enhanced.projection; that recipe marks this library native and skips it.
# generated by mkrecipe.py from stock ef49c09b7ab5eb72298f9973443b66b3 -> patched 36c65d80ea46f833f84c7567f43ffc2b
# holds only hashes of the stock bytes and the new bytes written
id carplay-core-read-wait-g70
file /system/lib/libCarPlayCore.so
verify 0x1482a 42 f167a8b61d9bbfe2a86eb973668a8abd 18c301cd2a43825630dbb44810b3d7fd
patch 0x1483a 0a
patch 0x14840 c0f20007
