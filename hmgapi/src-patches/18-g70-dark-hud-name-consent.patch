diff -ruN a/src/hmgapi/mods/wireless/dipo/G70Dark.java b/src/hmgapi/mods/wireless/dipo/G70Dark.java
--- a/src/hmgapi/mods/wireless/dipo/G70Dark.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/hmgapi/mods/wireless/dipo/G70Dark.java	2026-11-05 10:09:55.256802086 +0000
@@ -0,0 +1,106 @@
+package hmgapi.mods.wireless.dipo;
+
+import android.content.Context;
+
+import com.hkmc.setup.VideoSetupListener;
+import com.hkmc.setup.VideoSetupManager;
+
+/**
+ * G70 2.6.2 (src-patches/18): CarPlay always dark (setting g70_carplay_dark, on by
+ * default). The owner: "I set always dark: TMAP goes dark but CarPlay's background doesn't".
+ *
+ * The car decides CarPlay's appearance, not the iPhone: DiPO sends the night mode
+ * (CarPlayService.setNightMode) from the car's video setup (VideoSetupListener.onDimChanged:
+ * the brightness mode; on auto, the lights, getIlluminateStatus), so by day CarPlay's own
+ * screens are light whatever the iPhone's maps setting. Here the night mode is sent as on:
+ * when the wireless CarPlay session is up, a moment after each of the car's brightness or
+ * light changes (DiPO answers those first), and once a minute in case anything else turned
+ * it off. Through DiPO's own call; nothing in the car's settings changes.
+ */
+final class G70Dark {
+    private G70Dark() {}
+
+    static volatile boolean on;
+    static int sends;
+    static String lastResult;
+    static boolean wasUp;
+    static long lastAt;
+    static long EVERY_MS = 60000, AFTER_CHANGE_MS = 1500, LOOK_MS = 5000;
+
+    static void start(Context c, boolean enable) {
+        on = enable;
+        if (!on) return;
+        try {
+            new VideoSetupManager(c).addListener(new Listener());
+        } catch (Throwable t) {
+            Research.line("dark: no video setup listener: " + t);
+        }
+        G70Extra.later(new Runnable() {
+            @Override
+            public void run() {
+                while (on) {
+                    look();
+                    if (G70Extra.now) return;
+                    try {
+                        Thread.sleep(LOOK_MS);
+                    } catch (InterruptedException e) {
+                        return;
+                    }
+                }
+            }
+        }, LOOK_MS, "hmgapi-g70-dark");
+        Dipo.log("G70: CarPlay always dark (setting g70_carplay_dark)");
+    }
+
+    static boolean up() {
+        return Bridge.sCp != null && (Bridge.sCpWireless || Bridge.sCpClient);
+    }
+
+    /** every few seconds: a new session gets it at once, then once a minute */
+    static void look() {
+        boolean u = up();
+        if (u && (!wasUp || System.currentTimeMillis() - lastAt >= EVERY_MS)) send(wasUp ? "minute" : "session");
+        wasUp = u;
+    }
+
+    static final class Listener extends VideoSetupListener {
+        @Override
+        public void onDimChanged(int mode) {
+            soon("brightness mode " + mode);
+        }
+
+        @Override
+        public void onIlluminateStatusChanged(boolean lights) {
+            soon("lights " + lights);
+        }
+    }
+
+    static void soon(final String why) {
+        if (!on) return;
+        G70Extra.later(new Runnable() {
+            @Override
+            public void run() {
+                if (up()) send(why);
+            }
+        }, AFTER_CHANGE_MS, "hmgapi-g70-dark-change");
+    }
+
+    /** DiPO's CarPlayService.setNightMode(true) */
+    static synchronized void send(String why) {
+        Object cp = Bridge.sCp;
+        if (cp == null) return;
+        String r;
+        try {
+            r = String.valueOf(cp.getClass().getMethod("setNightMode", boolean.class).invoke(cp, true));
+        } catch (java.lang.reflect.InvocationTargetException x) {
+            r = "failed: " + x.getCause();
+        } catch (Throwable x) {
+            r = "failed: " + x;
+        }
+        sends++;
+        lastAt = System.currentTimeMillis();
+        if (sends == 1 || !r.equals(lastResult)) Dipo.log("G70: CarPlay night mode on (" + why + "): " + r);
+        if (!"minute".equals(why)) Research.line("dark: night mode on (" + why + "): " + r);
+        lastResult = r;
+    }
+}
