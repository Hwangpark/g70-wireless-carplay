-        void show(String text, String position, boolean cold);
-
-        void hide();
-    }
-
-    /** whether DiPO is the activity in front (the car: ActivityManager's top task; tests set it) */
-    interface Front {
-        boolean dipo();
-    }
-
-    static volatile boolean on;
-    static String position = "song";
-    static Ui ui;
-    static Front front;
-    static Handler main;
-    static volatile int mode = -1;
-    static volatile int oilRaw = -1, coolantRaw = -1;
-    static String shown;
-    /** below this the oil is still warming up (degrees): the display turns blue */
-    static int COLD_OIL = 70;
