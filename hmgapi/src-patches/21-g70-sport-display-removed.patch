-    static int currentDriveMode(Object m) {
-        for (String f : new String[] { "mCurrentDrviceMode", "mCurrentDriveMode" }) {
-            try {
-                return m.getClass().getField(f).getByte(m) & 0xff;
-            } catch (Throwable t) {
-                // the other spelling
-            }
-        }
