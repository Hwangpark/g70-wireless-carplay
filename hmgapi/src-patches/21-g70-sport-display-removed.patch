-    }
-
-    // ---- 2.6.3: the accelerator pedal and the longitudinal G (from the speed: the car's own
-    // acceleration value stays at -4.18, 11/05), a sample every 250 ms on a thread of its own
-    // while in sport mode with CarPlay in front; the car's telematics CAN service as G70Drive reads it
-
-    static volatile float pedal = -1, g = Float.NaN;
-    static volatile boolean frontNow, sampling;
-    static long SAMPLE_MS = 250, IDLE_MS = 1000;
-    private static final java.util.ArrayDeque<long[]> SPEEDS = new java.util.ArrayDeque<long[]>();   // {time ms, km/h x 100}
-
-    static void startSampler() {
-        sampling = true;
-        Thread t = new Thread(new Runnable() {
-            @Override
-            public void run() {
-                while (on) {
-                    boolean s = sport(mode);
-                    try {
-                        if (s) {
-                            frontNow = front != null && front.dipo();
-                            if (frontNow) sample(System.currentTimeMillis());
-                        }
-                        post();
-                        Thread.sleep(s ? SAMPLE_MS : IDLE_MS);
-                    } catch (InterruptedException e) {
-                        return;
-                    } catch (Throwable x) {
-                        Dipo.error("G70 sport display", x);
-                    }
-                }
-            }
-        }, "hmgapi-g70-gauge");
-        t.setDaemon(true);
-        t.start();
-    }
-
-    /** one sample: the pedal, and G over the last second of speeds */
-    static void sample(long now) {
-        Object h = G70Drive.hscan();
-        Object v = G70Drive.get(h, "getCarSpeed"), p = G70Drive.get(h, "getAccelPdlVal");
-        pedal = p instanceof Number ? ((Number) p).floatValue() : -1;
-        // 2.6.4: 511 km/h (the signal's "invalid", once at a restart on 11/06 16:08) is no speed
-        if (!(v instanceof Number) || !speedOk(((Number) v).floatValue())) {
-            g = Float.NaN;
-            return;
-        }
-        g = accelG(now, ((Number) v).floatValue());
-    }
-
-    /** the car's speed signal says 511 (0x1ff) when it has none */
-    static boolean speedOk(float kmh) {
-        return kmh >= 0 && kmh < 300;
-    }
-
-    /** m/s2 over about a second, in G (speed in whole km/h: steps of about 0.03 G) */
-    static synchronized float accelG(long now, float kmh) {
-        SPEEDS.addLast(new long[] { now, Math.round(kmh * 100) });
-        while (SPEEDS.size() > 1 && now - SPEEDS.peekFirst()[0] > 1500) SPEEDS.removeFirst();
-        long[] old = null;
-        for (long[] x : SPEEDS) {
-            if (now - x[0] >= 900) old = x;
-        }
-        if (old == null) return Float.isNaN(g) ? 0f : g;
-        float dt = (now - old[0]) / 1000f;
-        float dv = (Math.round(kmh * 100) - old[1]) / 100f / 3.6f;
-        return dv / dt / 9.81f;
-    }
-
-    static String modeName(int m) {
-        switch (m) {
-            case 0: return "0 (comfort)";
-            case 1: return "1 (sport)";
-            case 2: return "2 (eco)";
-            case 3: return "3 (sport+)";
-            case IN_BETWEEN: return "15 (changing)";
-            default: return String.valueOf(m);
-        }
-    }
-
-    /** for the research log: " = oil 85 C, coolant 92 C" (the formula is inferred) */
-    static String describe(byte[] b) {
-        if (b == null || b.length < 2) return "";
-        return " = oil " + degrees(b[0] & 0xff) + " C, coolant " + degrees(b[1] & 0xff) + " C";
-    }
-
-    static boolean cold() {
-        return oilRaw >= 0 && degrees(oilRaw) < COLD_OIL;
-    }
-
-    static void post() {
-        if (main == null) {
-            update();
-            return;
-        }
-        main.post(new Runnable() {
-            @Override
-            public void run() {
-                update();
-            }
-        });
-    }
-
-    /** on the main thread: show, refresh or hide; while in sport mode, look again every second (the screen in front changes) */
-    static void update() {
-        try {
-            boolean want = on && sport(mode) && (sampling ? frontNow : front != null && front.dipo());
-            if (want) {
-                String t = text();
-                boolean cold = cold();
-                String key = t + (cold ? " cold" : "");
-                if (!key.equals(shown)) {
-                    ui.show(t, position, cold);
-                    shown = key;
-                }
-            } else if (shown != null) {
-                ui.hide();
-                shown = null;
-            }
-        } catch (Throwable t) {
-            Dipo.error("G70 sport temperatures", t);
-        }
-    }
-}
