diff -ruN a/src/hmgapi/mods/wireless/dipo/G70Accel.java b/src/hmgapi/mods/wireless/dipo/G70Accel.java
--- a/src/hmgapi/mods/wireless/dipo/G70Accel.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/hmgapi/mods/wireless/dipo/G70Accel.java	2026-11-05 04:39:26.407592695 +0000
@@ -0,0 +1,52 @@
+package hmgapi.mods.wireless.dipo;
+
+import android.content.Context;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Handler;
+import android.os.HandlerThread;
+
+/**
+ * G70 2.6.0 (src-patches/16): the head unit's own accelerometer for G70Drive (research
+ * only): each axis summed on its own thread, the means handed over once a second.
+ * Throws when the unit has no accelerometer.
+ */
+final class G70Accel implements G70Drive.Accel, SensorEventListener {
+    private final float[] sum = new float[3];
+    private int n;
+
+    public G70Accel(Context c) {
+        SensorManager sm = (SensorManager) c.getSystemService(Context.SENSOR_SERVICE);
+        Sensor s = sm == null ? null : sm.getDefaultSensor(Sensor.TYPE_ACCELEROMETER);
+        if (s == null) throw new IllegalStateException("no accelerometer sensor");
+        HandlerThread t = new HandlerThread("hmgapi-g70-accel");
+        t.start();
+        if (!sm.registerListener(this, s, SensorManager.SENSOR_DELAY_GAME, new Handler(t.getLooper()))) {
+            throw new IllegalStateException("accelerometer not registered");
+        }
+        Research.line("drive: head unit accelerometer: " + s.getName() + " (" + s.getVendor() + ", range " + s.getMaximumRange() + ")");
+    }
+
+    @Override
+    public synchronized void onSensorChanged(SensorEvent e) {
+        if (e.values == null || e.values.length < 3) return;
+        sum[0] += e.values[0];
+        sum[1] += e.values[1];
+        sum[2] += e.values[2];
+        n++;
+    }
+
+    @Override
+    public void onAccuracyChanged(Sensor s, int accuracy) {}
+
+    @Override
+    public synchronized float[] take() {
+        if (n == 0) return null;
+        float[] m = { sum[0] / n, sum[1] / n, sum[2] / n };
+        sum[0] = sum[1] = sum[2] = 0;
+        n = 0;
+        return m;
+    }
+}
