+    /** the codes for a g70_icon_test choice; null when off */
+    static int[] testCodes(String choice) {
+        if (choice == null) return null;
+        if (choice.equals("known")) {
+            return new int[] { 3, 65, 66, 67, 68, 69, 70, 71, 72, 73, 81, 82, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106,
+                    107, 112, 113, 114, 144, 145, 172, 173, 174, 176 };
+        }
+        int dash = choice.indexOf('-');
+        if (dash <= 0) return null;
+        try {
+            int from = Integer.parseInt(choice.substring(0, dash)), to = Integer.parseInt(choice.substring(dash + 1));
+            if (from < 1 || to > 255 || to < from) return null;
+            int[] r = new int[to - from + 1];
+            for (int k = 0; k < r.length; k++) r[k] = from + k;
+            return r;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
