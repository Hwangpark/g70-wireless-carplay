+    void scheduleTest(long delay) {
+        if (Dipo.turnsHandler == null) return;
+        testStep = new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    stepTest();
+                } catch (Throwable x) {
+                    Dipo.error("CarPlay icon test", x);
+                }
+            }
+        };
+        Dipo.turnsHandler.postDelayed(testStep, delay);
+    }
