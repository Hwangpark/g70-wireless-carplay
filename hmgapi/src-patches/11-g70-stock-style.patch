+    static boolean has(String s, String... words) {
+        if (s == null) return false;
+        for (String w : words) if (s.contains(w)) return true;
+        return false;
+    }
+
+    /** TMAP sends tollgates as straight ahead; their name says it */
+    static boolean tollgate(Maneuver x) {
+        return x != null && (x.type == 3 || x.type == 5)
+                && (has(x.description, "TG", "\uD1A8\uAC8C\uC774\uD2B8", "\uC694\uAE08") || has(x.afterRoad, "TG", "\uD1A8\uAC8C\uC774\uD2B8"));
+    }
+
+    /** the far icon the car's navigation uses where it differs: highway exit right 164, keep right 161, exit left 82, tollgate 178 */
+    static int stockIcon(Maneuver x, int icon) {
+        if (x == null) return icon;
+        switch (x.type) {
+            case 23: return 164;
+            case 14: case 53: return 161;
+            case 22: return 82;
+            case 3: case 5: return tollgate(x) ? 178 : icon;
+            default: return icon;
+        }
+    }
+
+    /** the junction picture: {type, side streets, direction (degrees), starts within (m)}; null: icon only */
+    static float[] stockJunction(Maneuver x) {
+        if (x == null) return null;
+        switch (x.type) {
+            case 2: case 21: return new float[] { 13, 2065, 90f, 300 };     // right (11/05 08:23, a city right turn)
+            case 1: case 20: return new float[] { 13, 2065, 270f, 300 };    // left (11/05 08:21, a city left turn)
+            case 48: return new float[] { 13, 2081, 112.5f, 300 };          // sharp right
+            case 47: return new float[] { 13, 17414, 247.5f, 300 };         // sharp left
+            case 50: return new float[] { 13, 3, 22.5f, 300 };              // slight right
+            case 49: return new float[] { 13, 16385, 337.5f, 300 };         // slight left
+            case 4: case 18: case 26: return new float[] { 31, 0, 270f, 300 };   // U-turn
+            case 14: case 53: return new float[] { 13, 3, 22.5f, 600 };     // keep / change highway right
+            case 13: case 52: return new float[] { 13, 16385, 337.5f, 600 };   // keep / change highway left
+            case 23: return new float[] { 17, 0, 90f, 1000 };               // highway exit right
+            case 22: return new float[] { 43, 0, 270f, 600 };               // exit left
+            default: return null;
+        }
+    }
+
+    /** the distance bar: 90 when the picture starts, down to 10 */
+    static int stockBar(int m, int start) {
+        if (start <= 0) return 10;
+        return Math.max(10, Math.min(90, (int) Math.ceil(m * 9.0 / start) * 10));
+    }
+
+    static String stockNameOf(Maneuver x) {
+        if (x == null) return "";
+        if (x.afterRoad != null && x.afterRoad.length() > 0) return x.afterRoad;
+        return x.description == null ? "" : x.description;
+    }
+
+    void stockSend(Integer id, Update u, Maneuver x, int icon, float dist, int unit, int[] list) {
+        LinkedHashMap<Integer, Maneuver> m = maneuvers.get(id);
+        int[] ahead = aheadOf(list, m);
+        Maneuver y = ahead.length > 0 && m != null ? m.get(ahead[0]) : null;
+        Maneuver z = ahead.length > 1 && m != null ? m.get(ahead[1]) : null;
+        int meters = u.distNext;
+        float[] j = stockJunction(x);
+        if (x.index != jctIndex) jctIndex = -1;
+        if (j != null && meters > 0 && meters <= (int) j[3]) {
+            if (jctIndex != x.index) {
+                jctIndex = x.index;
+                jctStart = Math.max(meters, 50);
+                Dipo.log("CarPlay: G70 junction picture " + (int) j[0] + " (side " + (int) j[1] + ", " + j[2] + " deg) for maneuver "
+                        + x.index + " (type " + x.type + ") at " + meters + " m");
+            }
+            cluster.tbtInfo((int) j[0], (int) j[1], j[2], meters, 0, 0, Cluster.UNIT_M, stockBar(meters, jctStart), 0);
+            stockNear(x, meters, y, z);
+            return;
+        }
+        if (icon == 178 && meters > 0 && meters <= 500) {
+            cluster.tbtInfo(178, 0, 1912.5f, meters, 0, 15, Cluster.UNIT_M, Math.max(10, Math.min(50, (int) Math.ceil(meters / 100.0) * 10)), 0);
+            stockNear(x, meters, y, z);
+            return;
+        }
+        cluster.tbtInfo(icon, 0, 1912.5f, dist, 0, 15, unit, 0, -1);
+        stockName("");
+        int i2 = y == null || y.distance <= 0 ? 0 : stockIcon(y, iconOf(y, u.state));
+        int i3 = i2 == 0 || z == null || z.distance <= 0 ? 0 : stockIcon(z, iconOf(z, u.state));
+        stockHud(icon, i2, i3, stockNameOf(x));
+        cluster.tbtSubInfo2C(triple(dist, unit, 0), triple(dist, unit, 1), triple(dist, unit, 2),
+                tripleM(i2 == 0 ? -1 : y.distance, 0), tripleM(i2 == 0 ? -1 : y.distance, 1), tripleM(i2 == 0 ? -1 : y.distance, 2),
+                tripleM(i3 == 0 ? -1 : z.distance, 0), tripleM(i3 == 0 ? -1 : z.distance, 1), tripleM(i3 == 0 ? -1 : z.distance, 2));
+    }
+
+    /** near a turn or a tollgate: the name above the picture, the list empty, the HUD distance in metres */
+    void stockNear(Maneuver x, int meters, Maneuver y, Maneuver z) {
+        stockName(stockNameOf(x));
+        stockHud(0, 0, 0, null);
+        cluster.tbtSubInfo2C(0, 0, meters, tripleM(y == null ? -1 : y.distance, 0), tripleM(y == null ? -1 : y.distance, 1),
+                tripleM(y == null ? -1 : y.distance, 2), tripleM(z == null ? -1 : z.distance, 0), tripleM(z == null ? -1 : z.distance, 1),
+                tripleM(z == null ? -1 : z.distance, 2));
+    }
+
+    static int iconOf(Maneuver y, int state) {
+        int i = icon(y.type, y.side, y.junction, y.exit, state);
+        if (i == 0) i = g70Icon(y.type, y.side, y.exit, state);
+        return i;
+    }
+
+    void stockName(String name) {
+        if (name == null) name = "";
+        if (name.equals(stockName)) return;
+        stockName = name;
+        cluster.crossroadName(name);
+    }
+
+    /** the HUD list as the car's navigation sends it: F2, count, 3 icons, the road name (UTF-16LE), 4 zero bytes; empty near a turn */
+    void stockHud(int i1, int i2, int i3, String name) {
+        String key = i1 + "/" + i2 + "/" + i3 + "/" + name;
+        if (key.equals(stockHudKey)) return;
+        stockHudKey = key;
+        if (i1 == 0) {
+            cluster.turnListNew(new byte[] { (byte) 0xF2, 0, 0 });
+            return;
+        }
+        byte[] r;
+        try {
+            r = (name == null ? "" : name).getBytes("UTF-16LE");
+        } catch (java.io.UnsupportedEncodingException e) {
+            r = new byte[0];
+        }
+        int n = Math.min(r.length, 76);
+        byte[] f = new byte[5 + n + 4];
+        f[0] = (byte) 0xF2;
+        f[1] = (byte) (i3 != 0 ? 3 : i2 != 0 ? 2 : 1);
+        f[2] = (byte) i1;
+        f[3] = (byte) i2;
+        f[4] = (byte) i3;
+        System.arraycopy(r, 0, f, 5, n);
+        cluster.turnListNew(f);
+        hudType = i1;
+    }
+
+    /** one value of a 2C distance triple {unit, tenths, whole} for the phone's distance; k: 0 unit, 1 tenths, 2 whole */
+    static int triple(float f, int unit, int k) {
+        if (f < 0f || unit < 0 || unit > 4) return k == 2 ? 65535 : 15;
+        int whole = Math.min((int) f, 4095);
+        int tenths = 0;
+        if (unit == Cluster.UNIT_KM || unit == Cluster.UNIT_MI) tenths = Math.max(0, Math.min(9, (int) ((f - (int) f) * 10f + 0.5f)));
+        return k == 0 ? unit : k == 1 ? tenths : whole;
+    }
+
+    /** the same for a distance in metres (km from 1000 m, as the car's navigation); negative: none (15, 15, 65535) */
+    static int tripleM(int m, int k) {
+        if (m < 0) return k == 2 ? 65535 : 15;
+        if (m < 1000) return k == 0 ? Cluster.UNIT_M : k == 1 ? 0 : m;
+        int tenths = (m % 1000 + 50) / 100;
+        int whole = m / 1000;
+        if (tenths >= 10) {
+            tenths = 0;
+            whole++;
+        }
+        return k == 0 ? Cluster.UNIT_KM : k == 1 ? tenths : Math.min(whole, 4095);
+    }
+
+    /** arrived (state 2), once: as the car's navigation (11/04 18:52:58, 11/05 08:25:27) */
+    void stockArrived() {
+        if (arrivedSent) return;
+        arrivedSent = true;
+        cluster.tbtInfo(3, 65535, 1912.5f, 65535.15f, -3, 15, 15, 0, -1);
+        cluster.destinationName(0, "");
+        stockName("");
+        stockHud(0, 0, 0, null);
+        g70Shown = true;
+        Dipo.log("CarPlay: G70 arrived (as the car's navigation)");
+    }
+
+    void stockReset() {
+        stockHudKey = null;
+        stockName = null;
+        jctIndex = -1;
+    }
