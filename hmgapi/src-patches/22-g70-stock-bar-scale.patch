+    /**
+     * G70 2.6.6 (src-patches/22): the distance bar on the car's navigation's own scale of the
+     * distance left, not from where the picture started: 38 junction pictures of its guidance
+     * (11/04, 11/05, 11/07) step at the same distances whatever the start, and a picture that
+     * starts late (two turns close together) starts low (180 m: 50, 220 m: 60, 90 m: 20), where
+     * 2.4.0-2.6.5 started every picture at 90.
+     *   pictures from 300-400 m (crossings, U-turns): 90 above about 320 m, then a step every
+     *     35 m: 80 to 285, 70 to 250, 60 to 215, 50 to 180, 40 to 145, 30 to 110, 20 to 75, 10
+     *   from 600 m (highway keep, ramps): 80 under 580, 70 under 480, 60 under 430, 50 under 350,
+     *     40 under 280, 30 under 220, 20 under 170, 10 under 110
+     *   from 1 km (highway exit 17, tollgate): a step every 100 m, 90 at 1 km, 10 at 200 m
+     */
+    static int stockBar(int m, int scale) {
+        int bar;
+        if (scale >= 1000) {
+            bar = (m / 100 - 1) * 10;
+        } else if (scale >= 600) {
+            bar = 90;
+            for (int i = 0; i < BAR_600.length; i++) if (m < BAR_600[i]) bar = 80 - 10 * i;
+        } else {
+            bar = m < 75 ? 10 : 20 + 10 * ((m - 75) / 35);
+        }
+        return Math.max(10, Math.min(90, bar));
+    }
+
+    static final int[] BAR_600 = { 580, 480, 430, 350, 280, 220, 170, 110 };
+
+    /**
+     * G70 2.6.6: the distance as the car's navigation shows it near a turn: tens of metres
+     * under 300 m, hundreds from 300 m, km with one decimal from 1 km (its pictures: 400, 300,
+     * 270, 240 ... and 1.0 km, 900 m ...); 2.4.0-2.6.5 sent tens of metres (390 m, 1000 m)
+     */
+    static int stockMeters(int m) {
+        return m >= 300 ? m / 100 * 100 : m / 10 * 10;
+    }
