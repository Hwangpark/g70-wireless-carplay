+    /** one sample: the pedal, and G over the last second of speeds */
+    static void sample(long now) {
+        Object h = G70Drive.hscan();
+        Object v = G70Drive.get(h, "getCarSpeed"), p = G70Drive.get(h, "getAccelPdlVal");
+        pedal = p instanceof Number ? ((Number) p).floatValue() : -1;
+        if (!(v instanceof Number)) {
+            g = Float.NaN;
+            return;
+        }
+        g = accelG(now, ((Number) v).floatValue());
+    }
+
+    /** m/s2 over about a second, in G (speed in whole km/h: steps of about 0.03 G) */
+    static synchronized float accelG(long now, float kmh) {
+        SPEEDS.addLast(new long[] { now, Math.round(kmh * 100) });
+        while (SPEEDS.size() > 1 && now - SPEEDS.peekFirst()[0] > 1500) SPEEDS.removeFirst();
+        long[] old = null;
+        for (long[] x : SPEEDS) {
+            if (now - x[0] >= 900) old = x;
+        }
+        if (old == null) return Float.isNaN(g) ? 0f : g;
+        float dt = (now - old[0]) / 1000f;
+        float dv = (Math.round(kmh * 100) - old[1]) / 100f / 3.6f;
+        return dv / dt / 9.81f;
     }
 
