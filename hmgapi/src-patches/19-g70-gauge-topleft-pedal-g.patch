+    // ---- 2.6.3: the accelerator pedal and the longitudinal G (from the speed: the car's own
+    // acceleration value stays at -4.18, 11/05), a sample every 250 ms on a thread of its own
+    // while in sport mode with CarPlay in front; the car's telematics CAN service as G70Drive reads it
+
+    static volatile float pedal = -1, g = Float.NaN;
+    static volatile boolean frontNow, sampling;
+    static long SAMPLE_MS = 250, IDLE_MS = 1000;
+    private static final java.util.ArrayDeque<long[]> SPEEDS = new java.util.ArrayDeque<long[]>();   // {time ms, km/h x 100}
+
+    static void startSampler() {
+        sampling = true;
+        Thread t = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                while (on) {
+                    boolean s = sport(mode);
+                    try {
+                        if (s) {
+                            frontNow = front != null && front.dipo();
+                            if (frontNow) sample(System.currentTimeMillis());
+                        }
+                        post();
+                        Thread.sleep(s ? SAMPLE_MS : IDLE_MS);
+                    } catch (InterruptedException e) {
+                        return;
+                    } catch (Throwable x) {
+                        Dipo.error("G70 sport display", x);
+                    }
+                }
+            }
+        }, "hmgapi-g70-gauge");
+        t.setDaemon(true);
+        t.start();
