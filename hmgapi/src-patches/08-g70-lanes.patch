diff -ruN a/src/hmgapi/mods/wireless/dipo/G70Lanes.java b/src/hmgapi/mods/wireless/dipo/G70Lanes.java
--- a/src/hmgapi/mods/wireless/dipo/G70Lanes.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/hmgapi/mods/wireless/dipo/G70Lanes.java	2026-11-04 00:20:54.432345803 +0000
@@ -0,0 +1,135 @@
+package hmgapi.mods.wireless.dipo;
+
+import java.util.ArrayList;
+
+/**
+ * G70 (src-patches/08): the phone's LaneGuidanceInformation (iAP2 0x5204), read from the
+ * wireless CarPlay channel's bytes as they come in (Bridge.onCpIapIn), because the car's
+ * iAP2 server never passes it on: its RouteGuidanceUpdate component is declared without
+ * lane capacity, so 0x5204 doesn't become notification 122 (drive log 11/04: 45 of them,
+ * none reached a listener). Reads only; the bytes go on to the server unchanged.
+ *
+ * Parameters as seen (sizes only so far): 0 component (2 bytes), 1 lane guidance index
+ * (2), 3 a short value (4-6), and 2 once per lane, a group of 0 lane index (2), 1 status
+ * (1), 2 angles (2 each, signed degrees), 3 highlight angle (2, only on some lanes). Each
+ * one is logged in full to the research log, to check this reading on the next drive.
+ */
+final class G70Lanes {
+    static final int MSG = 0x5204;
+    static int logged;
+
+    private G70Lanes() {}
+
+    static int u16(byte[] b, int o) {
+        return ((b[o] & 0xff) << 8) | (b[o + 1] & 0xff);
+    }
+
+    /** iAP2 link packets, as Research.iap walks them; only control messages 0x5204 are read */
+    static void feed(byte[] b, int len) {
+        CpTurns t = Dipo.turns;
+        if (b == null || t == null || !t.lanesOn) return;
+        try {
+            if (len > b.length || len < 0) len = b.length;
+            int o = 0;
+            while (o + 9 <= len && (b[o] & 0xff) == 0xff && (b[o + 1] & 0xff) == 0x5a) {
+                int plen = u16(b, o + 2);
+                if (plen < 9) break;
+                int p = o + 9, end = Math.min(o + plen, len);
+                if (end - p >= 6 && (b[p] & 0xff) == 0x40 && (b[p + 1] & 0xff) == 0x40 && u16(b, p + 4) == MSG) {
+                    decode(b, p + 6, Math.min(p + u16(b, p + 2), end));
+                }
+                o += plen;
+            }
+        } catch (Throwable x) {
+            // reading only: CarPlay goes on
+        }
+    }
+
+    static void decode(byte[] b, int o, int end) {
+        int index = -1, component = -1;
+        String text = null;
+        final ArrayList<int[]> lanes = new ArrayList<int[]>();
+        StringBuilder raw = new StringBuilder();
+        while (o + 4 <= end) {
+            int plen = u16(b, o), pid = u16(b, o + 2);
+            if (plen < 4 || o + plen > end) break;
+            int d = o + 4, dl = plen - 4;
+            if (pid == 0 && dl >= 2) component = u16(b, d);
+            else if (pid == 1 && dl >= 2) index = u16(b, d);
+            else if (pid == 2) lanes.add(lane(b, d, d + dl));
+            else if (pid == 3) text = text(b, d, dl);
+            raw.append(' ').append(pid).append(':').append(hex(b, d, dl, 16));
+            o += plen;
+        }
+        StringBuilder s = new StringBuilder("lanes 0x5204 component ").append(component).append(" index ").append(index)
+                .append(" text ").append(text == null ? "-" : "\"" + text + "\"").append(" lanes ").append(lanes.size()).append(':');
+        for (int[] l : lanes) {
+            s.append(" [status ").append(l[0]).append(l[1] != 0 ? " hi " + l[2] : "").append(" angles");
+            for (int k = 3; k < l.length; k++) s.append(' ').append(l[k]);
+            s.append(']');
+        }
+        String line = s.toString();
+        Dipo.research(line + " | raw" + raw);
+        if (logged < 20 && CpTurns.debug) {
+            logged++;
+            Dipo.log("CarPlay dbg " + line);
+        }
+        if (index < 0) return;
+        final int i = index;
+        final int[][] a = lanes.toArray(new int[lanes.size()][]);
+        Dipo.post(new Runnable() {
+            @Override
+            public void run() {
+                Dipo.turns.g70Lanes(i, a);
+            }
+        });
+    }
+
+    /** one lane: {status, highlighted (0/1), highlight angle, angles...} */
+    static int[] lane(byte[] b, int o, int end) {
+        int status = 1, hi = 0, hiAngle = 0;
+        ArrayList<Integer> angles = new ArrayList<Integer>();
+        while (o + 4 <= end) {
+            int plen = u16(b, o), pid = u16(b, o + 2);
+            if (plen < 4 || o + plen > end) break;
+            int d = o + 4, dl = plen - 4;
+            if (pid == 1 && dl >= 1) status = dl >= 2 ? u16(b, d) : b[d] & 0xff;
+            else if (pid == 2) {
+                for (int k = 0; k + 1 < dl; k += 2) angles.add((int) (short) u16(b, d + k));
+            } else if (pid == 3 && dl >= 2) {
+                hi = 1;
+                hiAngle = (short) u16(b, d);
+            }
+            o += plen;
+        }
+        int[] r = new int[3 + angles.size()];
+        r[0] = status;
+        r[1] = hi;
+        r[2] = hiAngle;
+        for (int k = 0; k < angles.size(); k++) r[3 + k] = angles.get(k);
+        return r;
+    }
+
+    static String text(byte[] b, int d, int dl) {
+        int n = dl;
+        while (n > 0 && b[d + n - 1] == 0) n--;
+        for (int k = 0; k < n; k++) {
+            int c = b[d + k] & 0xff;
+            if (c < 0x20 && c != 0) return "hex:" + hex(b, d, dl, 16);
+        }
+        try {
+            return new String(b, d, n, "UTF-8");
+        } catch (Exception e) {
+            return "?";
+        }
+    }
+
+    static String hex(byte[] b, int d, int dl, int max) {
+        StringBuilder s = new StringBuilder();
+        for (int k = 0; k < dl && k < max; k++) {
+            String x = Integer.toHexString(b[d + k] & 0xff);
+            s.append(x.length() == 1 ? "0" : "").append(x);
+        }
+        return s.toString();
+    }
+}
