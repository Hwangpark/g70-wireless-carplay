+    /** G70 (src-patches/08): each network interface's traffic and errors per minute (the Wi-Fi link to the phone) */
+    private static final HashMap<String, long[]> NET = new HashMap<String, long[]>();
+    static final String[] NET_STATS = { "rx_bytes", "tx_bytes", "rx_packets", "tx_packets", "rx_errors", "tx_errors", "rx_dropped", "tx_dropped" };
+
+    static String netMinute() {
+        File[] ifs = new File("/sys/class/net").listFiles();
+        if (ifs == null) return null;
+        java.util.Arrays.sort(ifs);
+        StringBuilder b = new StringBuilder();
+        for (File i : ifs) {
+            String n = i.getName();
+            if (n.equals("lo")) continue;
+            long[] now = new long[NET_STATS.length];
+            boolean any = false;
+            for (int k = 0; k < now.length; k++) {
+                now[k] = readLong(new File(i, "statistics/" + NET_STATS[k]));
+                any |= now[k] >= 0;
+            }
+            if (!any) continue;
+            long[] was = NET.put(n, now);
+            if (was == null) continue;
+            long[] d = new long[now.length];
+            boolean moved = false;
+            for (int k = 0; k < d.length; k++) {
+                d[k] = now[k] >= 0 && was[k] >= 0 ? now[k] - was[k] : 0;
+                moved |= d[k] != 0;
+            }
