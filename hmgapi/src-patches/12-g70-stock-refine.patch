+    /** a named point TMAP sends as straight on: an IC or JC passed, a rest area (a tollgate keeps its own icon) */
+    static boolean passThrough(Maneuver x) {
+        if (x == null || (x.type != 3 && x.type != 5) || tollgate(x)) return false;
+        String n = x.afterRoad != null && x.afterRoad.length() > 0 ? x.afterRoad : x.description;
+        if (n == null) return false;
+        n = n.trim();
+        return n.endsWith("IC") || n.endsWith("JC") || has(n, "\uD734\uAC8C\uC18C", "\uC878\uC74C\uC27C\uD130");   // rest area, drowsy-driver shelter
+    }
+
+    /** a copy of a maneuver as a highway exit (type 22/23), for its junction picture */
+    static Maneuver asExit(Maneuver x, int type) {
+        Maneuver e = new Maneuver(x.index, 0, null);
+        e.index = x.index;
+        e.type = type;
+        e.description = x.description;
+        e.afterRoad = x.afterRoad;
+        e.distance = x.distance;
+        return e;
+    }
+
+    static int[] g70AddArm(int[] arms, int a) {
+        for (int x : arms) if (x == a) return arms;
+        int[] r = java.util.Arrays.copyOf(arms, arms.length + 1);
+        r[arms.length] = a;
+        return r;
+    }
+
+    /**
+     * The junction's real shape when the phone sends it (Apple Maps: the other roads' angles,
+     * item 10, and the exit angle, item 11; right positive): side street bits as the car's
+     * navigation sets them, 16 sectors of 22.5 degrees clockwise from straight on, bit k for
+     * k x 22.5 on the right, (k + 1) x 22.5 on the left, the road behind left out (decoded
+     * from its 15 junctions, 11/04-05). TMAP sends no angles: the usual shape is kept.
+     */
+    static float[] g70Shape(Maneuver x, float[] j) {
+        if (j == null || x == null || j[0] != 13 || x.g70Arms.length == 0 || x.exit == 0) return j;
+        int mask = 0;
+        for (int a : x.g70Arms) mask |= armBit(a);
+        mask |= armBit(x.exit);
+        float dir = Math.round(((x.exit % 360) + 360) % 360 / 22.5f) * 22.5f;
+        if (dir >= 360f) dir -= 360f;
+        return mask == 0 ? j : new float[] { 13, mask, dir, j[3] };
+    }
+
+    static int armBit(int angle) {
+        int a = ((angle % 360) + 360) % 360;
+        int k = Math.round(a / 22.5f) % 16;
+        if (k == 8) return 0;                // the road we come from
+        if (k > 8) k -= 1;
+        return 1 << k;
+    }
