+    /**
+     * G70 2.7.0: when the head unit asked for route guidance (cp> 0x5200) and when the phone last
+     * answered (cp< 0x5201). A map app that doesn't give iOS its turns leaves the HUD empty: the
+     * iPhone sent nothing at all for two whole Naver Map drives (11/10, 11/11) and one state 0
+     * when they ended. Said once per request, 20 s after it, in HMG-API's log too.
+     */
+    static volatile long rgAskedAt, rgAnsweredAt;
+    static volatile boolean rgSaid;
+    static long RG_WAIT_MS = 20000;
+
+    static void routeGuidance(String dir, int id, long now) {
+        if ("cp>".equals(dir) && id == 0x5200) {
+            rgAskedAt = now;
+            rgSaid = false;
+        } else if ("cp>".equals(dir) && id == 0x5203) {
+            rgAskedAt = 0;
+        } else if ("cp<".equals(dir) && (id == 0x5201 || id == 0x5202)) {
+            rgAnsweredAt = now;
+        } else if (rgAskedAt > 0 && !rgSaid && rgAnsweredAt < rgAskedAt && now - rgAskedAt >= RG_WAIT_MS) {
+            rgSaid = true;
+            both("CarPlay: the phone is navigating but its map app sends no route guidance ("
+                    + (now - rgAskedAt) / 1000 + " s after the request): nothing to show on the cluster and HUD");
+        }
+    }
+
