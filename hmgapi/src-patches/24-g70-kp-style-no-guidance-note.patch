+    // ---- Korea Projection's near-turn picture (setting g70_tbt_style = "kp") ----
+    // kpJunction, kpDisplay, kpExitBit, kpExitSlot, kpStreetBit, kpSideBits, kpBar and kpExpressway
+    // are adapted from Korea Projection (https://github.com/StopDragon/korea-projection, AGPL-3.0;
+    // its mod source: StopDragon/HMG-API, branch korea-build, commit 6b72110, dipo/CpTurns.java:
+    // near, nearDisplay, exitBit, exitSlot, streetBit, sideBits, bar, expressway), 2026-11-11.
+    // Changed here: fitted to this file's Maneuver and stock-style flow; no picture for a tollgate
+    // (it keeps the car's own 178 with its bar); the roundabout branch takes this file's icon.
+
+    /** where Korea Projection starts the near-turn picture (m): 350 in general, 1050 for highway exits */
+    static final int KP_D_GENERAL = 350, KP_D_EXPRESSWAY = 1050;
+
+    /** {picture type, side street bits, direction (degrees), starts within (m)} as Korea Projection sends them; null: icon only */
+    static float[] kpJunction(Maneuver x, int icon) {
+        if (x == null || tollgate(x)) return null;
+        int[] disp = kpDisplay(x.type, x.side, x.junction, x.exit, icon);
+        if (disp == null) return null;
+        int bits = disp[1] < 0 ? 0 : kpSideBits(x.g70Arms, disp[1]);
+        return new float[] { disp[0], bits, disp[2] * 7.5f, kpExpressway(x.type) ? KP_D_EXPRESSWAY : KP_D_GENERAL };
+    }
+
+    /** the bar: 10 x floor(left x 10 / D), 10 to 90 */
+    static int kpBar(int remain, int d) {
+        int b = (int) ((long) remain * 10L / d);
+        if (b < 1) b = 1;
+        if (b > 9) b = 9;
+        return b * 10;
+    }
+
+    static boolean kpExpressway(int type) {
+        return type == 8 || type == 22 || type == 23 || type == 51 || type == 52 || type == 53;
+    }
+
+    /**
+     * {picture type, the exit's side street bit (-1: none), direction slot (7.5 degrees)}; null: no picture.
+     * Highway exit 17 (right) / 18 (left), U-turn 31, fork 25, a roundabout its exit icon, any other turn 13.
+     */
+    static int[] kpDisplay(int type, int side, int junction, int exit, int icon) {
+        switch (type) {
+            case 22: case 52: return new int[] { 18, -1, 36 };
+            case 23: case 53: return new int[] { 17, -1, 12 };
+            case 8: case 51: {
+                boolean left = exit < 0 || (exit == 0 && side == 1);
+                return left ? new int[] { 18, -1, 36 } : new int[] { 17, -1, 12 };
+            }
+            case 4: case 26: return new int[] { 31, -1, side == 1 ? 12 : 36 };
+            case 13: return new int[] { 25, -1, exit != 0 ? kpExitSlot(exit) : 42 };
+            case 14: return new int[] { 25, -1, exit != 0 ? kpExitSlot(exit) : 6 };
+            default: break;
+        }
+        if (junction == 1 || type == 6 || type == 7 || type == 19 || (type >= 28 && type <= 46)) {
+            if (icon <= 0) return null;
+            return new int[] { icon, kpExitBit(exit), kpExitSlot(exit) };
+        }
+        int dir;
+        switch (type) {
+            case 1: case 20: dir = 36; break;
+            case 2: case 21: dir = 12; break;
+            case 47: dir = 30; break;
+            case 48: dir = 18; break;
+            case 49: dir = 42; break;
+            case 50: dir = 6; break;
+            case 3: case 5: case 9: dir = 0; break;
+            default: return null;
+        }
+        return exit != 0 ? new int[] { 13, kpExitBit(exit), kpExitSlot(exit) } : new int[] { 13, dir / 3, dir };
+    }
+
+    static int kpExitBit(int exit) {
+        int b = kpStreetBit(exit);
+        if (b >= 0) return b;
+        int cw = ((exit % 360) + 360) % 360;
+        return cw <= 179 ? 7 : 8;
+    }
+
+    static int kpExitSlot(int exit) {
+        int b = kpStreetBit(exit);
+        if (b >= 0) return 3 * b;
+        int cw = ((exit % 360) + 360) % 360;
+        return cw <= 179 ? 21 : 27;
+    }
+
+    /** one angle's side street bit: straight on 0, then one bit per 22.5 degrees clockwise (1 to 15); the road behind -1 */
+    static int kpStreetBit(int angle) {
+        int cw = ((angle % 360) + 360) % 360;
+        if (cw >= 348 || cw <= 12) return 0;
+        if (cw > 168 && cw < 192) return -1;
+        int n = (int) ((cw - 12) / 22.5) + 1;
+        return n > 15 ? 15 : n;
+    }
+
+    static int kpSideBits(int[] angles, int exitBit) {
+        int bits = 0;
+        if (angles != null) {
+            for (int a : angles) {
+                int b = kpStreetBit(a);
+                if (b >= 0) bits |= 1 << b;
+            }
+        }
+        if (exitBit >= 0 && exitBit <= 15) bits |= 1 << exitBit;
+        return bits & 0xFFFF;
+    }
