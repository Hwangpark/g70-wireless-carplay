+    /**
+     * G70: an icon for the maneuvers the build's table leaves blank (0), so the cluster
+     * and HUD aren't left showing nothing: Apple Maps starts every route with "start
+     * route" (11), and Korean routes are full of keep left / keep right (13, 14) and
+     * turns at angles the table doesn't list. Only icons the table itself uses: 65
+     * straight, 66-68 slight/normal/sharp right, 69-71 sharp/normal/slight left, 72/73
+     * U-turn, 81/82 off ramp right/left, 112 destination (3 once arrived), 176 ferry.
+     */
+    static int g70Icon(int type, int side, int exit, int state) {
+        switch (type) {
+            case 0: case 3: case 5: case 9: case 11: case 51:   // no turn, straight, follow road, on ramp, start route, change highway
+                return 65;
+            case 1: case 20: case 47: case 49:   // left, left at end, sharp left, slight left
+                return left(exit, type == 47 ? 69 : type == 49 ? 71 : 70);
+            case 2: case 21: case 48: case 50:   // right, right at end, sharp right, slight right
+                return right(exit, type == 48 ? 68 : type == 50 ? 66 : 67);
+            case 13: case 52:   // keep left, change highway left
+                return 71;
+            case 14: case 53:   // keep right, change highway right
+                return 66;
+            case 4: case 18: case 26:   // U-turn, start route with U-turn, U-turn when possible
+                return side == 1 ? 73 : 72;
+            case 8: return side == 1 ? 82 : 81;   // off ramp: the side traffic exits on
+            case 22: return 82;
+            case 23: return 81;
+            case 10: case 12: case 24: case 25: case 27:   // arrive
+                return state == 2 ? 3 : 112;
+            case 15: case 16: case 17: return 176;   // ferry
+            default:   // roundabouts (6, 7, 19, 28-46) and anything newer: by the exit angle
+                if (exit < -22) return left(exit, 70);
+                if (exit > 22) return right(exit, 67);
+                return 65;
+        }
+    }
+
+    /** a left turn by its exit angle (0: unknown, the given icon) */
+    static int left(int exit, int none) {
+        int a = Math.abs(exit);
+        if (a == 0) return none;
+        if (a <= 52) return 71;
+        return a <= 112 ? 70 : 69;
+    }
+
+    /** a right turn by its exit angle (0: unknown, the given icon) */
+    static int right(int exit, int none) {
+        int a = Math.abs(exit);
+        if (a == 0) return none;
+        if (a <= 52) return 66;
+        return a <= 112 ? 67 : 68;
+    }
