+    /**
+     * G70: a "no route" (state 0) from a source name other than the one guiding. A Korean
+     * iPhone sends route guidance under two names (G70 log, 11/03): "Apple 지도" with state
+     * 0 or 3 and "Apple Maps" with the route (state 6, maneuvers), one after the other.
+     * Each state 0 blanked the HUD under the route. While one name guides, a state 0 from
+     * the other (or a nameless one right after it) keeps the guiding state; the guiding
+     * name's own state 0 ends guidance as before, and so does 30 s without a word from it.
+     */
+    boolean g70Other(Iap2NotiMsg msg) {
+        String name = null;
+        int st = -1;
+        Iap2NotiMsg.Iap2ObjGroup g = msg.getItemGroup();
+        if (g == null) return false;
+        for (int k = 0; k < g.getItemCnt(); k++) {
+            Iap2NotiMsg.Iap2ObjItem it = g.getObjItem(k);
+            if (it == null || it.getItemObjCount() <= 0) continue;
+            try {
+                if (it.getItemId() == 19 && it.getItemParamType() == 10) {
+                    String[] v = it.getItemStringArray();
+                    if (v != null && v.length > 0 && v[0] != null && v[0].length() > 0) name = v[0];
+                } else if (it.getItemId() == 1 && it.getItemParamType() == 8) {
+                    int[] v = it.getItemIntArray();
+                    if (v != null && v.length > 0) st = v[0];
+                }
+            } catch (Throwable x) {
+                // an item it can't read: as if it wasn't there
+            }
+        }
+        String who = name != null ? name : lastName;
+        if (name != null) lastName = name;
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (st >= 0 && dbgStates < 300) {
+            dbgStates++;
+            Dipo.log("CarPlay dbg state " + st + " from " + (name != null ? name : "(" + who + ")") + " arg " + a1 + "/" + a2);
+        }
+        if (st > 0) {
+            if (who != null && !who.equals(navName)) Dipo.log("CarPlay: route guidance state " + st + " from " + who);
+            if (who != null) navName = who;
+            navAt = now;
+            cancelStop();
+            return false;
+        }
+        if (navName == null || who == null) return false;
+        if (who.equals(navName)) {
+            navAt = now;
+            return false;
+        }
+        if (st != 0 || now - navAt > 30000L) return false;
+        skipped++;
+        if (skipped == 1 || skipped == 10 || skipped == 100 || skipped % 1000 == 0)
+            Dipo.log("CarPlay: kept " + navName + "'s route over " + skipped + " \"no route\" update(s) from " + who);
+        scheduleStop(30000L);
+        return true;
+    }
+
+    /** G70: end guidance if the guiding name stays quiet for 30 s after a kept "no route" */
+    void scheduleStop(long delay) {
+        if (pendingStop != null || Dipo.turnsHandler == null) return;
+        pendingStop = new Runnable() {
+            @Override
+            public void run() {
+                pendingStop = null;
+                try {
+                    if (navName == null) return;
+                    long quiet = android.os.SystemClock.elapsedRealtime() - navAt;
+                    if (quiet < 30000L) {
+                        scheduleStop(30000L - quiet);
+                        return;
+                    }
+                    Dipo.log("CarPlay: nothing from " + navName + " for 30 s after a \"no route\": guidance ended");
+                    navName = null;
+                    for (Update u : updates.values()) {
+                        if (u != null) u.state = 0;
+                    }
+                    stop();
+                } catch (Throwable x) {
+                    Dipo.error("CarPlay turn-by-turn", x);
+                }
+            }
+        };
+        Dipo.turnsHandler.postDelayed(pendingStop, delay);
+    }
+
+    void cancelStop() {
+        if (pendingStop == null) return;
+        if (Dipo.turnsHandler != null) Dipo.turnsHandler.removeCallbacks(pendingStop);
