+++ b/src/hmgapi/mods/wireless/G70Research.java	2026-11-03 13:24:33.786742937 +0000
@@ -0,0 +1,235 @@
+package hmgapi.mods.wireless;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.HandlerThread;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+
+import hmgapi.hook.ModContext;
+import hmgapi.hook.Points;
+
+/**
+ * G70 research log (setting g70_debug, on by default from 2.2.1) outside DiPO (DiPO's
+ * part has its own, dipo.Research):
+ *   - the car navigation app (com.mnsoft.navi): every NavigationCluster call it makes
+ *     (turn info, lanes, turn lists, crossroad and destination names) with its arguments,
+ *     when they change apart from distances (at most one line per call kind per 2 s), to
+ *     g70-navi.log (3 MB, then .1) in its cache folder: how the car's own guidance drives
+ *     the cluster and HUD, icon codes and lane frames included
+ *   - the iAP2 server: the feature switches and counts it identifies the head unit with
+ *     (Iap2InitInformationMsg's numbers and the persist.sys.iap2.* properties, no names or
+ *     serials) and the broadcasts it gets, to HMG-API's log
+ * Reads only: a call goes on (or is skipped by the turn-by-turn hook) as before.
+ */
+final class G70Research {
+    static volatile boolean on;
+    static ModContext mod;
+    private static Handler h;
+    private static File file, old;
+    private static FileOutputStream out;
+    private static long size;
+    private static final long MAX = 3L << 20;
+    private static final SimpleDateFormat TIME = new SimpleDateFormat("MM-dd HH:mm:ss.SSS", Locale.ROOT);
+    private static final HashMap<String, String> LAST = new HashMap<String, String>();
+    private static final HashMap<String, Long> LAST_TIME = new HashMap<String, Long>();
+    private static final HashMap<String, Integer> CALLS = new HashMap<String, Integer>();
+    /** calls that are mostly distance and time: the first 3, then one in 60 */
+    private static final HashSet<String> COUNTDOWN = new HashSet<String>(java.util.Arrays.asList(
+            "update_remain_dis", "update_tbt_sub_info", "update_tbt_sub_info_b", "update_tbt_sub_info_2c"));
+    private static final HashSet<String> ACTIONS = new HashSet<String>();
+    private static String lastInit;
+
+    private G70Research() {}
+
+    /** the navigation app's log: on opens it, off deletes what an earlier start left; returns on */
+    static boolean navi(ModContext m, Context c, boolean enable) {
+        mod = m;
+        try {
+            File dir = c.getCacheDir();
+            file = new File(dir, "g70-navi.log");
+            old = new File(dir, "g70-navi.log.1");
+            if (!enable) {
+                if (file.delete() | old.delete()) m.log("G70 research: navigation log off, files deleted");
+                return false;
+            }
+            HandlerThread t = new HandlerThread("hmgapi-g70-navi");
+            t.start();
+            h = new Handler(t.getLooper());
+            on = true;
+            line("==== navigation app started, research log on (" + file + ")");
+            m.log("G70 research: navigation app's cluster calls go to " + file);
+            return true;
+        } catch (Throwable x) {
+            m.error("G70 research: navigation log", x);
+            return false;
+        }
+    }
+
+    static void line(final String s) {
+        if (!on) return;
+        final long now = System.currentTimeMillis();
+        h.post(new Runnable() {
+            @Override
+            public void run() {
+                write(TIME.format(new Date(now)) + " " + s + "\n");
+            }
+        });
+    }
+
+    private static void write(String s) {
+        try {
+            if (out == null) {
+                out = new FileOutputStream(file, true);
+                size = file.length();
+            }
+            byte[] b = s.getBytes("UTF-8");
+            out.write(b);
+            out.flush();
+            size += b.length;
+            if (size > MAX) {
+                out.close();
+                out = null;
+                old.delete();
+                file.renameTo(old);
+            }
+        } catch (Throwable x) {
+            on = false;
+        }
+    }
+
+    /** a NavigationCluster call in the navigation app (before it runs) */
+    static void naviCall(String m, Object[] args, boolean skipped) {
+        if (!on) return;
+        try {
+            int n;
+            synchronized (CALLS) {
+                Integer c = CALLS.get(m);
+                n = c == null ? 1 : c + 1;
+                CALLS.put(m, n);
+            }
+            if (n == 1) mod.log("G70 research: car navigation calls " + m + " (first)");
+            boolean countdown = COUNTDOWN.contains(m);
+            if (countdown) {
+                if (n > 3 && n % 60 != 0) return;
+            } else {
+                String key = describe(args, true, 0);
+                long now = System.currentTimeMillis();
+                synchronized (LAST) {
+                    if (key.equals(LAST.get(m))) return;
+                    Long t = LAST_TIME.get(m);
+                    if (t != null && now - t < 2000) return;   // the change shows again on a later call
+                    LAST.put(m, key);
+                    LAST_TIME.put(m, now);
+                }
+            }
+            line("navi " + m + " #" + n + (skipped ? " (skipped, phone guides)" : "") + ": " + describe(args, false, 0));
+        } catch (Throwable x) {
+            // reading only
+        }
+    }
+
+    /** arguments as text; key: floats and fields about distance or time left out (what's compared) */
+    static String describe(Object o, boolean key, int depth) {
+        if (o == null) return "null";
+        if (o instanceof Float || o instanceof Double) return key ? "~" : String.valueOf(o);
+        if (o instanceof Number || o instanceof Boolean || o instanceof Character) return String.valueOf(o);
+        if (o instanceof String) return "\"" + o + "\"";
+        if (o instanceof byte[]) {
+            byte[] b = (byte[]) o;
+            StringBuilder s = new StringBuilder("hex(").append(b.length).append("):");
+            for (int k = 0; k < b.length && k < 160; k++) {
+                String x = Integer.toHexString(b[k] & 0xff);
+                s.append(x.length() == 1 ? "0" : "").append(x);
+            }
+            return s.toString();
+        }
+        if (o instanceof int[]) return java.util.Arrays.toString((int[]) o);
+        if (o instanceof long[]) return java.util.Arrays.toString((long[]) o);
+        if (o instanceof float[]) return key ? "~" : java.util.Arrays.toString((float[]) o);
+        if (o instanceof Object[]) {
+            Object[] a = (Object[]) o;
+            StringBuilder s = new StringBuilder("[");
+            for (int k = 0; k < a.length && k < 16; k++) s.append(k == 0 ? "" : ", ").append(describe(a[k], key, depth + 1));
+            return s.append(a.length > 16 ? ", ..]" : "]").toString();
+        }
+        if (depth > 2) return o.getClass().getSimpleName();
+        StringBuilder s = new StringBuilder(o.getClass().getSimpleName()).append('{');
+        int k = 0;
+        for (Class<?> c = o.getClass(); c != null && c != Object.class; c = c.getSuperclass()) {
+            for (Field f : c.getDeclaredFields()) {
+                if (Modifier.isStatic(f.getModifiers())) continue;
+                String n = f.getName().toLowerCase(Locale.ROOT);
+                if (key && (n.contains("dist") || n.contains("time") || n.contains("remain"))) continue;
+                try {
+                    f.setAccessible(true);
+                    s.append(k++ == 0 ? "" : ", ").append(f.getName()).append('=').append(describe(f.get(o), key, depth + 1));
+                } catch (Throwable x) {
+                    // skip it
+                }
+            }
+        }
+        return s.append('}').toString();
+    }
+
+    /**
+     * The iAP2 server, after it checks its features: Iap2InitInformationMsg's numbers (what
+     * the head unit tells the iPhone it supports: masks, counts, the route guidance flag
+     * HMG-API sets) and the persist.sys.iap2.* switches they come from, when they change.
+     */
+    static void initInfo(ModContext m, ClassLoader cl) {
+        try {
+            Class<?> c = Points.cls(cl, "iap2.init_info");
+            if (c == null) return;
+            StringBuilder nums = new StringBuilder(), props = new StringBuilder();
+            Class<?> sp = Class.forName("android.os.SystemProperties");
+            java.lang.reflect.Method get = sp.getMethod("get", String.class);
+            for (Field f : c.getDeclaredFields()) {
+                if (!Modifier.isStatic(f.getModifiers())) continue;
+                f.setAccessible(true);
+                Class<?> t = f.getType();
+                if (t == int.class || t == boolean.class || t == long.class) {
+                    if (f.getName().equals("TRUE") || f.getName().equals("FALSE")) continue;
+                    nums.append(' ').append(f.getName()).append('=').append(f.get(null));
+                } else if (t == String.class && f.getName().startsWith("PROPERTY_") && !f.getName().contains("ADDRESS")) {
+                    Object k = f.get(null);
+                    if (!(k instanceof String)) continue;
+                    String v = (String) get.invoke(null, k);
+                    props.append(' ').append(k).append('=').append(v == null || v.isEmpty() ? "-" : v);
+                }
+            }
+            String all = nums + " |" + props;
+            if (all.equals(lastInit)) return;
+            lastInit = all;
+            chunks(m, "iAP2 server features", nums.toString());
+            chunks(m, "iAP2 server switches", props.toString());
+        } catch (Throwable x) {
+            m.error("G70 research: iAP2 features", x);
+        }
+    }
+
+    private static void chunks(ModContext m, String what, String s) {
+        int parts = (s.length() + 899) / 900, k = 0;
+        for (int o = 0; o < s.length(); o += 900) {
+            k++;
+            m.log("G70 research: " + what + " (" + k + "/" + parts + "):" + s.substring(o, Math.min(s.length(), o + 900)));
+        }
+    }
+
+    /** the iAP2 server's broadcasts, the first of each action */
+    static void action(ModContext m, String a) {
+        if (a == null) return;
+        synchronized (ACTIONS) {
+            if (!ACTIONS.add(a)) return;
+        }
+        m.log("G70 research: iAP2 server got broadcast " + a + " (first)");
+    }
+}
